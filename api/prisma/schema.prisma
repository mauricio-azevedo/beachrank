generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GroupVisibility {
  PUBLIC
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum MatchTeam {
  TEAM_A
  TEAM_B
}

enum MatchProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum GroupRankingProjectionStatus {
  CURRENT
  PROCESSING
  FAILED
}

enum RankingMovementDirection {
  UP
  DOWN
}

enum ProcessingJobType {
  MATCH_CREATED
  MATCH_UPDATED
  MATCH_DELETED
  GROUP_RANKING_REBUILD
  // Deprecated: platform-trending was retired. Kept to avoid a fragile enum-value removal.
  PLATFORM_TRENDING_PLAYERS_REBUILD
}

enum ProcessingJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ProcessingJobScope {
  GROUP
  // Deprecated: platform-trending was retired. Kept to avoid a fragile enum-value removal.
  PLATFORM
}

enum FeedItemType {
  GROUP_CREATED
  MEMBER_JOINED
  MATCH_CLOSE
  MATCH_BLOWOUT
  UPSET_WIN
  RANKING_MOVEMENT
}

enum FeedItemScope {
  GROUP
  USER
}

enum FeedItemVisibility {
  GROUP_MEMBERS
  SOCIAL_CIRCLE
  PUBLIC
  PRIVATE
}

enum NotificationType {
  CLAIM_REQUEST // deprecated — pre-email-anchored claim flow
  CLAIM_APPROVED // deprecated
  CLAIM_DECLINED // deprecated
  CLAIM_INVITE // deprecated
  CLAIM_OFFER // admin anchored an email to a stub → offer to that account
  CLAIM_OFFER_DECLINED // the offered person declined → tell the admin
  GUEST_TAKEN_OVER // a guest was taken over via an invite → inform group admins
}

// State of the email an admin anchored to a stub (jogador sem conta).
enum ClaimEmailStatus {
  PENDING
  DECLINED
}

model User {
  id           String @id @default(uuid())
  firstName    String
  lastName     String
  email        String @unique
  passwordHash String

  // Optional display name shown to others in groups (overrides first+last when set).
  nickname String?
  // Palette key for the user's avatar gradient (frontend owns key→gradient). Always
  // set — assigned (varied) at registration; the default is a NOT-NULL safety net.
  avatarColor String @default("blue")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdGroups           Group[]                 @relation("GroupCreator")
  memberships             GroupMember[]
  createdInvites          GroupInvite[]           @relation("GroupInviteCreator")
  actorFeedItems          FeedItem[]              @relation("FeedItemActorUser")
  subjectFeedItems        FeedItem[]              @relation("FeedItemSubjectUser")
  groupHighlights         GroupHighlight[]
  notifications           Notification[]          @relation("NotificationRecipient")

  @@index([email])
}

model Group {
  id          String          @id @default(uuid())
  name        String
  description String?
  visibility  GroupVisibility @default(PUBLIC)
  // Palette key for the group's avatar gradient (frontend owns key→gradient). Chosen
  // when the group is created; the default is a NOT-NULL safety net.
  avatarColor String          @default("blue")

  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                 GroupMember[]
  matches                 Match[]
  invites                 GroupInvite[]
  feedItems               FeedItem[]
  rankingMovements        RankingMovement[]
  processingJobs          ProcessingJob[]
  rankingProjection       GroupRankingProjection?
  matchRankingSnapshots   MatchRankingSnapshot[]
  homeSummary             GroupHomeSummary?
  memberStats             GroupMemberStats[]
  memberPartnerStats      GroupMemberPartnerStats[]
  groupHighlights         GroupHighlight[]
  notifications           Notification[]


  @@index([visibility, createdAt])
  @@index([name])
  @@index([createdById])
}

model GroupInvite {
  id String @id @default(uuid())

  token String @unique

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("GroupInviteCreator", fields: [createdById], references: [id])

  expiresAt DateTime?
  revokedAt DateTime?

  uses    Int  @default(0)
  maxUses Int?

  // Optional target guest: null = open invite (group roster, self-identify); set = closed
  // invite (addressed to one guest, deep-links to its recognition). FK by composite
  // (id, groupId) so the target can never belong to another group.
  targetGroupMemberId String?
  targetGroupMember   GroupMember? @relation("GroupInviteTarget", fields: [targetGroupMemberId, groupId], references: [id, groupId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([createdById])
  @@index([token])
  @@index([targetGroupMemberId])
}

model GroupMember {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Null for stub players (jogadores sem conta): created inline so someone can be
  // scored today without owning an account. displayName then holds their name.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set only for stubs; null when userId is present (name comes from the User).
  displayName String?

  rating           Float  @default(1000)
  ratingDeviation  Float?
  ratingVolatility Float?
  ratingMu         Float?
  ratingSigma      Float?
  ratingAlgorithm  String @default("BEACH_ELO_V1")
  currentRank      Int?

  role GroupMemberRole @default(MEMBER)

  leftAt DateTime?

  // Email-anchored claim (stubs only): an admin attaches an email; when an account with
  // that email exists/registers, it's offered the stub's history to confirm. The email
  // value itself is the auth nonce for the confirm — editing it invalidates old offers.
  claimEmail           String?
  claimEmailStatus     ClaimEmailStatus?
  claimEmailNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchPlayers          MatchPlayer[]
  targetedByInvites     GroupInvite[]       @relation("GroupInviteTarget")
  actorFeedItems        FeedItem[]          @relation("FeedItemActorGroupMember")
  rankingMovements      RankingMovement[]
  stats                 GroupMemberStats?
  partnerStats          GroupMemberPartnerStats[] @relation("PartnerStatsOwner")
  partneredStats        GroupMemberPartnerStats[] @relation("PartnerStatsPartner")
  groupHighlights         GroupHighlight[]

  @@unique([groupId, userId])
  @@unique([id, groupId])
  @@unique([groupId, claimEmail])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, rating])
  @@index([groupId, currentRank, rating])
  @@index([groupId, role])
  @@index([claimEmail])
}

model GroupMemberStats {
  groupMemberId String @id
  groupId       String

  matchesCount Int @default(0)
  winsCount    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupMember GroupMember @relation(fields: [groupMemberId, groupId], references: [id, groupId], onDelete: Cascade)

  @@unique([groupMemberId, groupId])
  @@index([groupId])
  @@index([groupId, matchesCount])
}

// Derived read model (rebuilt by GroupMemberPartnerStatsProjectionService, never
// hand-edited): one directional row per (player, teammate) pairing within a group,
// so each player reads `WHERE groupMemberId = :me`. Powers the profile screen's
// "melhor dupla" / "suas duplas" without scanning every match at read time.
model GroupMemberPartnerStats {
  id      String @id @default(uuid())
  groupId String

  groupMemberId   String
  partnerMemberId String

  matchesTogether Int @default(0)
  winsTogether    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupMember   GroupMember @relation("PartnerStatsOwner", fields: [groupMemberId, groupId], references: [id, groupId], onDelete: Cascade)
  partnerMember GroupMember @relation("PartnerStatsPartner", fields: [partnerMemberId, groupId], references: [id, groupId], onDelete: Cascade)

  @@unique([groupMemberId, partnerMemberId])
  @@index([groupId])
  @@index([groupMemberId, winsTogether])
}

enum HighlightType {
  WIN_STREAK_CURRENT
  WIN_STREAK_RECORD
  CLIMB
  LEADERSHIP
  MILESTONE_MATCHES
  MILESTONE_WINS
}

// Derived read model (rebuilt by the weekly-highlights projection in the GROUP cascade,
// never hand-edited). One row per (groupMember, type); the 7-day window is applied at read time.
model GroupHighlight {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId, groupId], references: [id, groupId], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     HighlightType
  value    Int
  score    Float
  anchorAt DateTime

  algorithmVersion String @default("WEEKLY_HIGHLIGHTS_V1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupMemberId, type])
  @@index([groupId, anchorAt])
  @@index([score])
  @@index([userId, anchorAt])
}

model Match {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  gamesA Int
  gamesB Int

  winnerTeam MatchTeam?

  teamAExpected Float?
  teamBExpected Float?
  teamAActual   Float?
  teamBActual   Float?

  teamARatingBefore Float?
  teamBRatingBefore Float?
  teamARatingAfter  Float?
  teamBRatingAfter  Float?

  ratingAlgorithm String @default("BEACH_ELO_V1")

  processingStatus MatchProcessingStatus @default(PROCESSED)
  processedAt      DateTime?
  processingError   String?
  deletedAt         DateTime?

  playedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players          MatchPlayer[]
  feedItems        FeedItem[]
  rankingMovements RankingMovement[]
  rankingSnapshot  MatchRankingSnapshot?
  processingJobs   ProcessingJob[]

  @@unique([id, groupId])
  @@index([groupId])
  @@index([groupId, playedAt, createdAt])
  @@index([groupId, winnerTeam])
  @@index([groupId, ratingAlgorithm])
  @@index([groupId, processingStatus])
  @@index([groupId, deletedAt])
}

model MatchPlayer {
  id String @id @default(uuid())

  matchId String
  groupId String

  match Match @relation(fields: [matchId, groupId], references: [id, groupId], onDelete: Cascade)

  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId, groupId], references: [id, groupId], onDelete: Restrict)

  team     MatchTeam
  position Int

  ratingBefore Float
  ratingAfter  Float
  ratingDelta  Float

  rankBefore Int?
  rankAfter  Int?
  rankDelta  Int?

  movementDirection RankingMovementDirection?
  movementPositions Int?

  ratingDeviationBefore  Float?
  ratingDeviationAfter   Float?
  ratingVolatilityBefore Float?
  ratingVolatilityAfter  Float?

  ratingMuBefore    Float?
  ratingMuAfter     Float?
  ratingSigmaBefore Float?
  ratingSigmaAfter  Float?

  playedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, groupMemberId])
  @@unique([matchId, team, position])
  @@index([matchId])
  @@index([groupId])
  @@index([groupId, playedAt])
  @@index([groupId, groupMemberId])
  @@index([groupId, groupMemberId, playedAt])
  @@index([groupMemberId])
  @@index([groupMemberId, playedAt])
  @@index([groupId, rankBefore, rankAfter])
}

model MatchRankingSnapshot {
  matchId String @id
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  previousLeaders  Json @default("[]")
  currentLeaders   Json @default("[]")
  dethronedLeaders Json @default("[]")
  movements        Json @default("[]")

  algorithmVersion String @default("BEACH_ELO_V1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([algorithmVersion])
}

model GroupRankingProjection {
  groupId String @id
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  status GroupRankingProjectionStatus @default(CURRENT)
  version Int @default(0)

  processingJobId String?
  lastProcessedMatchId String?
  lastProcessedAt DateTime?
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastProcessedAt])
}

model GroupHomeSummary {
  groupId String @id
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  membersCount Int @default(0)
  leaders      Json @default("[]")

  lastRelevantFeedItemId String?
  lastRelevantFeedItem   FeedItem? @relation("GroupHomeSummaryLastRelevantFeedItem", fields: [lastRelevantFeedItemId], references: [id], onDelete: SetNull)
  lastRelevantAt         DateTime?

  projectionStatus GroupRankingProjectionStatus?
  lastProcessedAt  DateTime?
  lastError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastRelevantAt])
  @@index([projectionStatus])
}

model RankingMovement {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId, groupId], references: [id, groupId], onDelete: Cascade)

  matchId String
  match   Match  @relation(fields: [matchId, groupId], references: [id, groupId], onDelete: Cascade)

  direction RankingMovementDirection
  positions Int

  previousRank Int
  currentRank  Int

  previousRating Float
  currentRating  Float

  passedGroupMemberIds Json @default("[]")

  isVisible     Boolean   @default(false)
  occurredAt    DateTime
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([matchId, groupMemberId])
  @@index([groupId, occurredAt])
  @@index([groupMemberId, occurredAt])
  @@index([matchId])
  @@index([groupId, isVisible])
}

model ProcessingJob {
  id String @id @default(uuid())

  type   ProcessingJobType
  scope  ProcessingJobScope @default(GROUP)
  status ProcessingJobStatus @default(PENDING)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  matchId String?
  match   Match?  @relation(fields: [matchId, groupId], references: [id, groupId], onDelete: Cascade)

  dedupeKey String?
  payload Json @default("{}")

  attemptCount Int @default(0)
  maxAttempts  Int @default(5)

  availableAt DateTime @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, availableAt])
  @@index([scope, status, availableAt])
  @@index([groupId, status, createdAt])
  @@index([matchId])
  @@index([dedupeKey])
  @@index([lockedBy])
}

model FeedItem {
  id String @id @default(uuid())

  type       FeedItemType
  scope      FeedItemScope
  visibility FeedItemVisibility

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorUser   User?   @relation("FeedItemActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  actorGroupMemberId String?
  actorGroupMember   GroupMember? @relation("FeedItemActorGroupMember", fields: [actorGroupMemberId], references: [id], onDelete: SetNull)

  subjectUserId String?
  subjectUser   User?   @relation("FeedItemSubjectUser", fields: [subjectUserId], references: [id], onDelete: Cascade)

  matchId String?
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  groupHomeSummaries GroupHomeSummary[] @relation("GroupHomeSummaryLastRelevantFeedItem")

  importanceScore Int @default(0)

  metadata Json

  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@unique([type, matchId])
  @@index([scope, occurredAt])
  @@index([visibility, occurredAt])
  @@index([groupId, occurredAt])
  @@index([type, occurredAt])
  @@index([importanceScore, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@index([actorGroupMemberId, occurredAt])
  @@index([matchId])
}

// Per-user in-app notification. Unlike FeedItem (group-public activity, no recipient,
// no read state), this targets one user and tracks read/acted. `data` is a denormalized
// render payload (names, counts, deep-link refs) so the inbox needs no joins and old
// notifications keep rendering even after the entities they describe change.
model Notification {
  id              String           @id @default(uuid())
  type            NotificationType
  recipientUserId String
  recipientUser   User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  groupId         String?
  group           Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actorUserId     String?
  // The entity this notification is about (e.g. the stub a CLAIM_OFFER points at). A plain
  // column, no FK — the stub can be deleted by a merge, and we only need it to resolve the
  // notification (mark acted) when that entity's state changes.
  targetGroupMemberId String?
  data            Json             @default("{}")
  readAt          DateTime?
  actedAt         DateTime?
  createdAt       DateTime         @default(now())

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@index([targetGroupMemberId])
}
